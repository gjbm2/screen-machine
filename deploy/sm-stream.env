# sm-stream.env: settings for the production stream_service, run by scripts/ctl in GNU screen session 'sm-stream'.
#
# OWNER: screen-machine-04. The owner edits STREAM_ARGS and the extra variables (never add CUDA_VISIBLE_DEVICES).
# STREAM_PORT is the AV-block allocation in docs/PORTS.md (LAN only, never WAN). Change it only through the
# register (screen-machine-ca) and Spectre, because the Windows port-forward and firewall rule are keyed to it.
# Never put --port in STREAM_ARGS. Any other KEY=VALUE line here is passed to the process as an env var.
# Format: KEY=VALUE per line, read by scripts/ctl (never sourced). After an edit: scripts/ctl restart stream.
# STREAM_HOLD: while this line exists, scripts/ctl start/restart stream (and Spectre's buttons) refuse with
# the reason. The owner deletes the line to release the service for production.
STREAM_PORT=8702
STREAM_ARGS="--host 0.0.0.0 --public-base ws://192.168.1.205:8702 --config-dir config/live --show-bus ws://127.0.0.1:8701/v1/show --log-level INFO"
PYTHONUNBUFFERED=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
