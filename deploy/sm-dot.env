# sm-dot.env: settings for dot_service (the e-ink tags, config/room/dot.json), run by scripts/ctl in GNU screen
# session 'sm-dot'. Always on: it starts with `scripts/ctl start all`. Spectre card: screen-machine-dot.
# DOT_PORT is the AV-block allocation in docs/PORTS.md: 127.0.0.1 only. Never put --port in DOT_ARGS.
# The Dot. API key is in ~/.config/screen-machine/dot.json, never here. After an edit: scripts/ctl restart dot.
DOT_PORT=8704
DOT_ARGS="--log-level INFO"
