@@ new helper (shared by diag and hud)
+def glass_client(clients) -> "Optional[MediaClient]":
+    """The TV's own player: the page room_service drives (glass), else a visible kiosk-role page, else a kiosk
+    page, else None.  Never chosen by presented count; ties go to the most recent stats."""
+    def rank(c):
+        st = c.stats or {}
+        return (st.get("glass") is True, st.get("role") in (None, "kiosk") and st.get("hidden") is not True,
+                st.get("role") in (None, "kiosk"), getattr(c, "stats_at", 0.0))
+    have = [c for c in clients if c.stats]
+    if not have:
+        return None
+    best = max(have, key=rank)
+    return best if rank(best)[2] or rank(best)[0] else None     # a viewer/lab page is never "the glass"

