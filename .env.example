# .env.example: copy to .env and fill in the blanks. Site addresses live here (and the GPU renderer's in
# deploy/sm-stream.env), never in code. Secrets are blank here and never go in git.

# --- Frontend (Vite) ---
VITE_API_URL=http://95.141.21.170:5000/api   # or your backend API URL
VITE_WS_HOST=ws://95.141.21.170:8765         # or your websocket host

# --- Backend (Python) ---
VITE_URL=http://95.141.21.170:8000           # or your frontend URL

OPENAI_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ID=
# RUNPOD_PUBLIC_IP=your-public-ip-here
RUNPOD_TCP_PORT_8765=8765
# Audio processing
ASSEMBLY_AI_KEY=
VITE_APP_BASE_URL=http://95.141.21.170:8000  # base URL for Android app deeplinks (AndroidApp.tsx)
ADMIN_API_TOKEN=

# --- Alerting (Siren): docs/ALERTING_PROPOSAL.md ---
# Gmail OAuth creds shared with ~/dev/auto-klevio (refresh tokens are shareable)
ALERT_EMAIL_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>   # create a free check at healthchecks.io (10-min grace), then uncomment

# Room control plane (LAN only). The one place the LAN address lives (owner, 14 Oct).
# VITE_ROOM_URL: baked into the app at build time (display pages connect here; the Room page talks here).
# SM_LAN_HOST: room_service's allowed Host and its default web origins are derived from it.
VITE_ROOM_URL=http://192.168.1.205:8700
SM_LAN_HOST=192.168.1.205
VITE_APP_LAN_URL=http://192.168.1.205:8080
