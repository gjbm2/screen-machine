{% include "overlay_panel_common_head.html.j2" %}

{# Auto is off and the room hears something a mode is made for (routes/room_hints.py, config/room/auto_hints.json).
   TITLE, LINE, MODES [{label, voice}], ROOM_URL, ROOM_QR, DURATION (s: the countdown, as every panel has). #}
<style>
  .overlay-panel.auto-hint {
    flex-direction: row;
    align-items: center;
    gap: 40px;
    max-width: 52vw;
  }
  .auto-hint .say { margin-left: 20px; letter-spacing: -0.25px; }
  .auto-hint .ask { font-style: italic; margin-top: 18px; }
</style>

{% set voiced = MODES | selectattr("voice") | list %}
<div class="overlay-panel bottom-left auto-hint">
  <div style="animation: fadeInUp 1.6s ease 0.2s forwards; opacity: 0;">
    <div style="font-weight: 400; font-size: 1.4em;">{{ TITLE }}</div>
    {% if LINE %}<div style="opacity: 0.85;">{{ LINE }}</div>{% endif %}

    <div class="ask">Let the room follow it:</div>
    <div class="say">computer, use AI to <span style="font-weight: 700;">follow the music</span></div>

    <div class="ask">Or pick
      {%- for m in MODES %}{% if loop.first %} {% elif loop.last %} or {% else %}, {% endif %}<span style="font-weight: 400; font-style: normal;">{{ m.label }}</span>{% endfor %}:</div>
    {% if voiced %}
    <div class="say">computer, use AI to switch to <span style="font-weight: 700;">{{ voiced[0].voice }} mode</span></div>
    {% endif %}
  </div>

  {# a column a little wider than the QR, so its words wrap centred under it #}
  <div style="flex-shrink: 0; width: 190px; text-align: center; line-height: 1.4;
              animation: fadeIn 1.6s ease 0.6s forwards; opacity: 0;">
    <div style="width: 150px; margin: 0 auto; border-radius: 12px; overflow: hidden;">
      <img src="{{ ROOM_QR }}" style="display: block; width: 100%; height: auto; opacity: 0.8;" />
    </div>
    <div style="font-size: 0.75em; opacity: 0.7; margin-top: 10px;">Auto and modes on the Room page</div>
    <div style="font-size: 0.55em; opacity: 0.6; margin-top: 4px;">{{ ROOM_URL | replace("/", "<wbr>/") }}</div>
  </div>

  {% include "overlay_spinner.html.j2" %}
</div>
