{
  "name": "marvin_interpret",
  "description": "Infers the user's intent, responds in Marvin's sardonic SSML tone, and optionally returns an image prompt or modifies system behavior.",
  "parameters": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string",
        "enum": ["respond_only", "generate_image", "other_action", "change_refiner", "animate", "set_variable", "trigger", "adapt", "combine", "undo", "redo", "load_schedule", "unload_schedule", "set_mode", "set_auto", "set_listening", "cue_scene", "set_effect"],
        "description": "The user's intent. One of: 'respond_only', 'generate_image', 'other_action', 'animate', 'set_variable', 'change_refiner', 'trigger', 'adapt', 'combine', 'undo', 'redo', 'load_schedule', 'unload_schedule', 'set_mode' (change the room's mode), 'set_auto' (turn Auto on or off), 'set_listening' (turn AI listening on or off), 'cue_scene' (change the live scene) or 'set_effect' (change, add or clear the live effects)."
      },
      "response_ssml": {
        "type": "string",
        "description": "A sardonic SSML-wrapped response in Marvin's voice, using <speak><voice name='Brian'>...</voice></speak>."
      },
      "data": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "The image prompt to generate. For 'combine' intent, this describes how to combine the images (e.g., 'so the two people are hugging')."
          },
          "var_name": {
            "type": "string",
            "description": "The name of the variable to set when intent is set_variable."
          },
          "value": {
            "description": "The value to set the variable to when intent is set_variable."
          },
          "event_key": {
            "type": "string",
            "description": "The event key to trigger when intent is trigger."
          },
          "scope": {
            "type": "string",
            "description": "The scope (screen, group, or 'global') to trigger the event on when intent is trigger."
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": {{ ALEXA_TARGETS | tojson }}
            },
            "minItems": 1,
            "description": "Target screen(s) or group(s) for image display. For 'combine' intent, should specify targets to combine (will use first two available)."
          },
          "workflow": {
            "type": "string",
            "enum": {{ ALEXA_WORKFLOWS | tojson }},
            "description": "Optional image generation workflow to use. Selects the underlying image model and pipeline."
          },
          "refiner": {
            "type": "string",
            "enum": {{ ALEXA_REFINERS | tojson }},
            "description": "Optional refinement strategy. Influences tone, framing, or stylization of the final image prompt."
          },
          "script_name": {
            "type": "string",
            "description": "The name of the scheduler script to load when intent is load_schedule."
          },
          "mode": {
            "type": "string",
            "description": "For set_mode: the mode the user named, as one of the room's mode names (e.g. 'Party', 'Disco', 'Normal')."
          },
          "on": {
            "type": "boolean",
            "description": "For set_auto: true to turn Auto (the room listening and choosing modes) on, false to turn it off. For set_listening: true to turn AI listening (an online AI hearing the music) on, false to turn it off."
          },
          "query": {
            "type": "string",
            "description": "For cue_scene and set_effect: the user's words for the scene or effect (e.g. 'ocean', 'fractal zoom', 'film grain'). Empty for 'next scene'."
          },
          "effect_op": {
            "type": "string",
            "enum": ["replace", "add", "clear"],
            "description": "For set_effect: 'replace' the effects with this one (default), 'add' it to them, or 'clear' all effects."
          }
        },
        "additionalProperties": false
      }
    },
    "required": ["intent", "response_ssml"]
  }
}
