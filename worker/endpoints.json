{
  "note": "RunPod endpoints for the new worker (worker/endpoints.py saves them; saveEndpoint is a full replace). Secrets are RunPod secret references, never values.",
  "template": {
    "name": "sm-worker-2026-11-17",
    "image": "gjbm2/sm-worker:2026-11-18-2",
    "registry_auth": "cm88p5oli0001ky083ca8cu1f",
    "container_disk_gb": 30
  },
  "env": {
    "HF_TOKEN": "{{ RUNPOD_SECRET_hf_token }}",
    "BUCKET_ENDPOINT_URL": "{{ RUNPOD_SECRET_sm_bucket_url }}",
    "BUCKET_ACCESS_KEY_ID": "{{ RUNPOD_SECRET_sm_bucket_key_id }}",
    "BUCKET_SECRET_ACCESS_KEY": "{{ RUNPOD_SECRET_sm_bucket_secret }}",
    "COMFY_LOG_LEVEL": "INFO",
    "SM_REQUIRE_MODELS": "1"
  },
  "endpoints": {
    "sm-image": {
      "id": "1p4605rkgfo392",
      "gpus": "BLACKWELL_96,ADA_80_PRO,HOPPER_141",
      "workers_max": 3,
      "idle_timeout": 5,
      "execution_timeout_s": 1200,
      "bundle": "https://huggingface.co/gjbm2/sm-image-bundle:3bfda65d9f89bbb8eb5e0f8092a510095af3eb14"
    },
    "sm-live": {
      "gpus": "BLACKWELL_96,ADA_80_PRO,HOPPER_141",
      "workers_max": 2,
      "idle_timeout": 120,
      "execution_timeout_s": 1200,
      "bundle": "https://huggingface.co/gjbm2/sm-image-bundle:3bfda65d9f89bbb8eb5e0f8092a510095af3eb14",
      "note": "Interactive (generator page, Alexa): stays warm 2 min after a job or a warm-up, so the next picture starts at once. sm-image (TVs, schedules) keeps a 5 s idle timeout.",
      "id": "v0lfqu2owx3lc4"
    },
    "sm-zimage": {
      "template": "sm-worker-zimage",
      "gpus": "BLACKWELL_96,ADA_80_PRO,HOPPER_141",
      "workers_max": 3,
      "idle_timeout": 5,
      "execution_timeout_s": 1200,
      "bundle": "https://huggingface.co/gjbm2/sm-zimage-bundle:main",
      "note": "One model per endpoint (18 Nov): a worker FlashBoot resumes always has Z-Image loaded; no idle dwell. --disable-dynamic-vram so a resumed worker still holds the weights in GPU memory (DynamicVRAM re-reads them); SM_PREFETCH reads the weights into RAM while ComfyUI boots.",
      "id": "bm00rlfpej1cyj",
      "image": "gjbm2/sm-worker:2026-11-18-3",
      "env": {
        "COMFY_ARGS": "--disable-dynamic-vram",
        "SM_PREFETCH": "1"
      }
    }
  }
}
