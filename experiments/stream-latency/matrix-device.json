      "codec": "h264",
      "size": "1920x1080",
      "fps": 30,
      "client": {
        "mode": "webcodecs"
      }
    },
    {
      "codec": "h264",
      "size": "1920x1080",
      "fps": 30,
      "client": {
        "mode": "wctrack"
      }
    },
    {
      "codec": "h264",
      "size": "1920x1080",
      "fps": 30,
      "client": {
        "mode": "mse",
        "target": 2
      }
    },
    {
      "codec": "h264",
      "size": "1920x1080",
      "fps": 30,
      "client": {
        "mode": "mse",
        "target": 1
      }
    },
    {
      "codec": "h264",
      "size": "1920x1080",
      "fps": 30,
      "no_reorder_fix": true,
      "client": {
        "mode": "wctrack"
      }
    },
    {
