{
  "_note": "Room modes (docs/av/ROOM_STATE_MODEL.md): art, the screen live, and Karaoke (owner, 26 Nov: \"karaoke mode is essentially a switch on every mode, but it's false on every mode apart from one that happens also to be labelled 'karaoke'\"): the mode with \"karaoke\": true starts the karaoke player when entered and stops it when left; a song started elsewhere takes the room into it. Its director.light_scenes tag (modes:singalong) picks out the light scenes written for Karaoke alone (light_scenes.yaml tags.modes: the singer's spot while the room waits).",
  "default": "gallery",
  "transition_s": 3,
  "modes": {
    "gallery": {
      "label": "Normal",
      "state": {
        "screens": "art",
        "page": true,
        "sensor_mask": "follow",
        "light.house-*": {
          "set": {
            "hex": "#ffffff",
            "bri": 100
          }
        }
      }
    },
    "live": {
      "label": "Live",
      "state": {
        "screens": {
          "live": {
            "auto": true
          }
        },
        "page": true,
        "show.mic": {
          "set": true,
          "restore": true
        }
      }
    },
    "singalong": {
      "label": "Karaoke",
      "state": {
        "screens": {
          "live": {
            "auto": true
          }
        },
        "page": true,
        "show.mic": {
          "set": true,
          "restore": true
        },
        "show.main": {
          "set": {
            "vibe": "singalong",
            "listening": false
          },
          "restore": true,
          "policy": "ignore"
        },
        "light.house-*": "off",
        "director.light_scenes": {
          "set": {
            "scene_tags": [
              "modes:singalong"
            ]
          },
          "restore": true
        }
      },
      "karaoke": true
    }
  },
  "transitions": [
    {
      "_note": "Everything else.",
      "from": "*",
      "to": "*",
      "steps": [
        "sensor_mask",
        "page",
        "screens",
        "rest"
      ]
    }
  ]
}
