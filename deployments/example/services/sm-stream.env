# sm-stream.env: stream_service's flags for this deployment, read by scripts/ctl (KEY=VALUE, never sourced).
# The port is deployment.yaml's ports.stream. ${PORT_<SERVICE>} is that service's port from deployment.yaml;
# any other ${VAR} comes from the machine's .env (SM_LAN_HOST: this machine's LAN address). Any other KEY=VALUE line
# is passed to the process as an env var. After an edit: scripts/ctl restart stream.
# No --show-bus: this deployment has dmx off, so room_service serves no show bus (finsbury's flags show one).
STREAM_ARGS="--host 0.0.0.0 --public-base ws://${SM_LAN_HOST}:${PORT_STREAM} --config-dir config/live --music-bus ws://127.0.0.1:${PORT_SHOW}/v1/show --local-control --app-url http://${SM_LAN_HOST}:${PORT_ROOM}/renderer --log-level INFO"
PYTHONUNBUFFERED=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
