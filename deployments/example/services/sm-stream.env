# sm-stream.env: stream_service's flags for this deployment, read by scripts/ctl (KEY=VALUE, never sourced).
# The port comes from deployment.yaml (ports.stream). ${VAR} takes a value from the machine's .env.
# Any other KEY=VALUE line is passed to the process as an env var. After an edit: scripts/ctl restart stream.
STREAM_ARGS="--host 0.0.0.0 --public-base ws://${SM_LAN_HOST}:8702 --config-dir config/live --show-bus ws://127.0.0.1:8701/v1/show --music-bus ws://127.0.0.1:8703/v1/show --local-control --app-url http://${SM_LAN_HOST}:8700/renderer --log-level INFO"
PYTHONUNBUFFERED=1
CUDA_DEVICE_ORDER=PCI_BUS_ID
