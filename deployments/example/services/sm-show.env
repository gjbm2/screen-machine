# sm-show.env: show_service's flags for this deployment, read by scripts/ctl (KEY=VALUE, never sourced).
# The port comes from deployment.yaml (ports.show). Any other KEY=VALUE line is passed to the process as an env var.
SHOW_ARGS="--log-level INFO"
PYTHONUNBUFFERED=1
CUDA_VISIBLE_DEVICES=
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
