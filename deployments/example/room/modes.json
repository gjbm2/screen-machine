{
  "_note": "Room modes (docs/av/ROOM_STATE_MODEL.md). The smallest set: art, and the screen live.",
  "default": "gallery",
  "modes": {
    "gallery": {
      "label": "Normal",
      "state": {
        "screens": "art",
        "page": true,
        "sensor_mask": "follow"
      }
    },
    "live": {
      "label": "Live",
      "state": {
        "screens": {
          "live": {
            "auto": true
          }
        },
        "page": true
      }
    }
  },
  "transitions": [
    {
      "_note": "Everything else.",
      "from": "*",
      "to": "*",
      "steps": [
        "sensor_mask",
        "page",
        "screens",
        "rest"
      ]
    }
  ]
}
